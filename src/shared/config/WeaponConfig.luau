--!strict

-- Shared configuration for all Black Market Weapons, Ammo Calibers, Recoil Profiles & Reload Mechanics.
-- Used by both BlackMarketService (server authority) and WeaponController / EmpireMenuController (client UI & feel).

export type AmmoTypeId = "Pistol9mm" | "Shotgun12G" | "SMG45" | "Rifle556" | "Sniper308"
export type WeaponCategory = "Pistol" | "Shotgun" | "SMG" | "AssaultRifle" | "Sniper" | "Melee"
export type ReloadType = "Magazine" | "ShellByShell"
export type WeaponRarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Mythic"

export type AmmoPackOption = {
	Quantity: number,
	Price: number,
}

export type AmmoTypeSpec = {
	Id: AmmoTypeId,
	DisplayName: string,
	ShortName: string,
	Icon: string,
	MaxReserve: number,
	StarterReserve: number,
	Packs: { AmmoPackOption },
	AccentColor: Color3,
}

export type WeaponSpec = {
	Id: string,
	DisplayName: string,
	Icon: string,
	Category: WeaponCategory,
	Rarity: WeaponRarity,
	Price: number,
	RobuxItemId: string?, -- Non-nil for optional Robux GamePass weapons
	RobuxPrice: number?,
	RequiredLevel: number,
	Description: string,
	Damage: number,
	Pellets: number,
	Range: number,
	Cooldown: number,
	AutoFire: boolean,
	Spread: number,
	AmmoType: AmmoTypeId,
	MagSize: number,
	ReloadType: ReloadType,
	ReloadTime: number, -- Full magazine swap time OR per-shell insert time for ShellByShell
	ShellFinishTime: number?, -- Pump finish time after shotgun shell reload
	RecoilPitchDeg: number,
	RecoilBackStuds: number,
	RecoilYawDeg: number,
	RecoilCapDeg: number,
	AudioKey: "PistolShot" | "ShotgunBlast" | "SMGShot",
	ModelStyle: "StreetPistol" | "PepperShotgun" | "TacticalSMG" | "SilencedDeagle" | "AutoCombatShotgun" | "SyndicateCarbine" | "ShadowSniper" | "GoldenEmperorPistol" | "CrimsonDragonAR" | "MafiaKnife" | "SamuraiKatana" | "SyndicateTommyDrum" | "PhantomAssassinRifle",
