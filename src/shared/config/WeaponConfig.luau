function WeaponConfig.GetHighestUnlockedMastery(kills: number): MasterySkinId
	if kills >= 15 then
		return "Gold"
	elseif kills >= 8 then
		return "Crimson"
	elseif kills >= 3 then
		return "Damascus"
	end
	return "Standard"
end

function WeaponConfig.GetCompatibleWeaponsForAmmo(ammoId: AmmoTypeId): { string }
	local names: { string } = {}
	for _, wid in ipairs(WeaponConfig.WEAPON_ORDER) do
		local w = WeaponConfig.WEAPONS[wid]
		if w and w.AmmoType == ammoId then
			table.insert(names, w.DisplayName)
		end
	end
	return names
end

return WeaponConfig
