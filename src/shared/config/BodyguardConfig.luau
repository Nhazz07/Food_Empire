--!strict

-- Shared configuration for all 7 Recruitable Bodyguard Classes & 16 Compatible Bodyguard Equipment Items.

export type GuardClassId =
	"BasicGuard"
	| "HeavyGuard"
	| "AssaultGuard"
	| "SniperGuard"
	| "TacticalGuard"
	| "NinjaGuard"
	| "EliteGuard"
	| "BossBodyguard"

export type GuardGearSlot = "Armor" | "Helmet" | "Outfit" | "Weapon" | "Attachment" | "Tactical"
export type GuardCombatStyle = "Melee" | "Shotgun" | "Rifle" | "Sniper" | "Support" | "BossHeavy"

export type BodyguardClassSpec = {
	Id: GuardClassId,
	DisplayName: string,
	Icon: string,
	Role: string,
	Rarity: string,
	Cost: number,
	RobuxItemId: string?,
	RobuxPrice: number?,
	RequiredLevel: number,
	MaxHP: number,
	WalkSpeed: number,
	Damage: number,
	AttackRange: number,
	AttackCooldown: number,
	CombatStyle: GuardCombatStyle,
	Scale: number,
	AbilityName: string,
	AbilityDesc: string,
	Description: string,
	CoatColor: Color3,
	AccentColor: Color3,
	CompatibleGearTags: { [string]: boolean },
}

export type BodyguardGearSpec = {
	Id: string,
	DisplayName: string,
	Icon: string,
	Slot: GuardGearSlot,
	Rarity: string,
	Price: number,
	RobuxItemId: string?,
	RobuxPrice: number?,
	RequiredLevel: number,
	RequiredTag: string, -- Bodyguard class must include this tag in CompatibleGearTags!
	BonusHP: number,
	BonusDamage: number,
	BonusRange: number,
	BonusSpeed: number,
	CooldownMult: number, -- e.g. 0.85 reduces cooldown by 15%
	HealAuraBonus: number,
	StunEffect: boolean,
	Description: string,
	VisualColor: Color3,
}

