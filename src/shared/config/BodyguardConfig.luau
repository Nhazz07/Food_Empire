function BodyguardConfig.IsGearCompatible(classId: GuardClassId, gearId: string): boolean
	local cSpec = BodyguardConfig.CLASSES[classId]
	local gSpec = BodyguardConfig.GEAR[gearId]
	if not cSpec or not gSpec then
		return false
	end
	return cSpec.CompatibleGearTags[gSpec.RequiredTag] == true
end

function BodyguardConfig.GetCompatibleClassNames(gearId: string): { string }
	local out: { string } = {}
	for _, cid in ipairs(BodyguardConfig.CLASS_ORDER) do
		if BodyguardConfig.IsGearCompatible(cid, gearId) then
			table.insert(out, BodyguardConfig.CLASSES[cid].DisplayName)
		end
	end
	return out
end

return BodyguardConfig
